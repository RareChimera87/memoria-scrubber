{
  "name": "@memoria/scrubber",
  "version": "0.1.0",
  "description": "Zero-dependency isomorphic local secret scrubber for LLM context & MCP tools (Regex + Luhn + Shannon Entropy)",
  "license": "MIT",
  "author": "Santiago Reina",
  "repository": {
    "type": "git",
    "url": "https://github.com/RareChimera87/memoria-scrubber.git"
  },
  "keywords": [
    "llm",
    "mcp",
    "security",
    "secret-scrubber",
    "redact",
    "shannon-entropy",
    "luhn",
    "claude",
    "chatgpt",
    "cursor",
    "grok"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
